{
  "manifest_version": 3,
  "name": "Professor Ratings for Pitt",
  "version": "1.3.1",
  "description": "RateMyProfessors ratings and on-device AI review summaries inside Pitt class search. Unofficial; not affiliated with Pitt or RMP.",
  "minimum_chrome_version": "128",
  "permissions": [
    "storage",
    "offscreen",
    "scripting",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pitcsprd.csps.pitt.edu/ps*/pitcsprd/EMPLOYEE/SA/s/WEBLIB_HCX_CM*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Professor Ratings for Pitt"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "homepage_url": "https://github.com/Equinox2005/professor-ratings-for-pitt"
}
